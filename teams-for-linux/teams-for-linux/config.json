{
  "logConfig": false,
  "media": {
    "camera": {
      "resolution": {
        "enabled": true,
        "height": 1080,
        "mode": "override",
        "width": 1920
      }
    },
    "microphone": { "disableAutogain": true }
  },
  "notifications": {
    "badgeCountEnabled": false,
    "enabled": false,
    "sound": { "enabled": false },
    "windowFlash": false
  },
  "performance": {
    "disableGpu": true,
    "electronCLIFlags": [
      ["enable-features", "AcceleratedVideoEncoder,VaapiOnNvidiaGPUs"]
    ]
  },
  "platform": { "spellCheckerLanguages": ["en", "pl"] },
  "screenSharing": { "thumbnail": { "enabled": false } },
  "tray": { "enabled": false, "iconType": "light" },
  "window": { "closeOnCross": true }
}
