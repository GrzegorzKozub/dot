{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "bar": {
      "border": { "left": "", "right": "" },
      "char": { "elapsed": "⠶", "total": " " },
      "width": 8
    },
    "brightColor": false,
    "color": { "keys": "white" },
    "disableLinewrap": true,
    "key": { "width": 32 },
    "percent": {
      "color": { "green": "green", "red": "red", "yellow": "yellow" },
      "type": 9
    },
    "separator": ""
  },
  "general": {
    "preload": {
      // clean(...): drop [GTK2/3/4]-style toolkit tags and the parens around font sizes, then join the distinct non-empty parts with ", "
      "lua": "function clean(...) local t, seen = {}, {}; for _, s in ipairs({...}) do s = s:gsub('%s*%[.-%]', ''):gsub('%((%d+pt)%)', '%1'); if s ~= '' and not seen[s] then seen[s] = true; t[#t + 1] = s end end; return table.concat(t, ', ') end"
    }
  },
  "logo": {
    "source": "~/.config/fastfetch/arch.png",
    "type": "kitty-icat",
    "width": 16
  },
  "modules": [
    { "format": "{#blue}{host-name}", "type": "title" },
    "break",
    "os",
    "kernel",
    "locale",
    { "key": "Init system", "type": "initsystem" },
    { "key": "Login manager", "type": "lm" },
    "break",
    { "key": "Desktop environment", "type": "de" },
    { "key": "Window manager", "type": "wm" },
    {
      "format": "lua:local val = ...; return clean(val.theme1, val.theme2)",
      "type": "theme"
    },
    {
      "format": "lua:local val = ...; return clean(val.icons1, val.icons2)",
      "type": "icons"
    },
    {
      "format": "lua:local val = ...; return clean(val.combined)",
      "type": "font"
    },
    { "format": "{theme}{?size} {size}px{?}", "type": "cursor" },
    "break",
    "terminal",
    "shell",
    "editor",
    "break",
    { "key": "CPU usage", "type": "cpuusage" },
    "processes",
    "memory",
    "swap",
    "disk",
    "break",
    "board",
    "bios",
    "cpu",
    {
      "driverSpecific": true,
      "format": "{name} (PCIe {pcie-curr-speed})",
      "type": "gpu"
    },
    {
      "format": "lua:local val = ...; local t = {}; for _, c in ipairs(val.types) do if c ~= 'MJPEG' then t[#t + 1] = c:gsub(' / H%.265', '') end end; return table.concat(t, ', ')", // drop MJPEG and shorten "HEVC / H.265"
      "key": "Decoder",
      "showType": "decoder",
      "type": "codec"
    },
    {
      "format": "{width}x{height} @ {refresh-rate}Hz in {inch}\"{?hdr-compatible} (HDR{?hdr-enabled} on{?}){?}",
      "order": "asc",
      "type": "display"
    },
    "sound",
    "camera",
    "break",
    { "symbol": "circle", "type": "colors" }
  ]
}
