{
  "active_pane_modifiers": { "inactive_opacity": 0.8 },
  "agent": {
    "default_height": 256,
    "default_model": {
      "enable_thinking": false,
      "model": "llama",
      "provider": "llama",
    },
    "default_profile": "write",
    "default_width": 512,
    "dock": "right",
    "enable_feedback": false,
    "max_content_width": 768,
    "tool_permissions": {
      "tools": {
        "edit_file": {
          "default": "allow",
          "always_deny": [
            { "pattern": "env$" },
            { "pattern": "\\.(cert|crt|env|key|ovpn|pem|secret)$" },
            { "pattern": "(credentials|settings.xml)$" },
            { "pattern": "(\\.secrets|keys|pass|BraveSoftware)/" },
          ],
        },
        "write_file": {
          "default": "allow",
          "always_deny": [
            { "pattern": "env$" },
            { "pattern": "\\.(cert|crt|env|key|ovpn|pem|secret)$" },
            { "pattern": "(credentials|settings.xml)$" },
            { "pattern": "(\\.secrets|keys|pass|BraveSoftware)/" },
          ],
        },
        "delete_path": {
          "always_deny": [
            { "pattern": "env$" },
            { "pattern": "\\.(cert|crt|env|key|ovpn|pem|secret)$" },
            { "pattern": "(credentials|settings.xml)$" },
            { "pattern": "(\\.secrets|keys|pass|BraveSoftware)/" },
          ],
        },
        "move_path": {
          "always_deny": [
            { "pattern": "env$" },
            { "pattern": "\\.(cert|crt|env|key|ovpn|pem|secret)$" },
            { "pattern": "(credentials|settings.xml)$" },
            { "pattern": "(\\.secrets|keys|pass|BraveSoftware)/" },
          ],
        },
        "fetch": { "default": "allow" },
        "search_web": { "default": "allow" },
        "terminal": {
          "always_allow": [
            { "pattern": "^aws\\s+cloudwatch\\b" },
            { "pattern": "^aws\\s+logs\\b" },
            { "pattern": "^cargo\\b" },
            { "pattern": "^date\\b" },
            { "pattern": "^docker\\s+images\\b" },
            { "pattern": "^docker\\s+inspect\\b" },
            { "pattern": "^docker\\s+logs\\b" },
            { "pattern": "^docker\\s+ps\\b" },
            { "pattern": "^dotnet\\b" },
            { "pattern": "^echo\\b" },
            { "pattern": "^eslint\\b" },
            { "pattern": "^file\\b" },
            { "pattern": "^gh\\s+api\\b" },
            { "pattern": "^gh\\s+issue\\s+list\\b" },
            { "pattern": "^gh\\s+issue\\s+view\\b" },
            { "pattern": "^gh\\s+pr\\s+checks\\b" },
            { "pattern": "^gh\\s+pr\\s+diff\\b" },
            { "pattern": "^gh\\s+pr\\s+list\\b" },
            { "pattern": "^gh\\s+pr\\s+view\\b" },
            { "pattern": "^gh\\s+repo\\s+view\\b" },
            { "pattern": "^gh\\s+run\\s+list\\b" },
            { "pattern": "^gh\\s+run\\s+view\\b" },
            { "pattern": "^gh\\s+search\\b" },
            { "pattern": "^git\\s+-C\\b" },
            { "pattern": "^git\\s+clone\\b" },
            { "pattern": "^git\\s+fetch\\b" },
            { "pattern": "^git\\s+pull\\b" },
            { "pattern": "^go\\b" },
            { "pattern": "^gofmt\\b" },
            { "pattern": "^goimports\\b" },
            { "pattern": "^golangci-lint\\b" },
            { "pattern": "^govulncheck\\b" },
            { "pattern": "^jest\\b" },
            { "pattern": "^jq\\b" },
            { "pattern": "^make\\b" },
            { "pattern": "^mvn\\b" },
            { "pattern": "^mvnw\\b" },
            { "pattern": "^\\./mvnw\\b" },
            { "pattern": "^node\\b" },
            { "pattern": "^npm\\s+audit\\b" },
            { "pattern": "^npm\\s+ci$" },
            { "pattern": "^npm\\s+install$" },
            { "pattern": "^npm\\s+ls\\b" },
            { "pattern": "^npm\\s+outdated\\b" },
            { "pattern": "^npm\\s+run\\b" },
            { "pattern": "^npm\\s+test\\b" },
            { "pattern": "^npx\\s+--no-install\\b" },
            { "pattern": "^podman\\s+images\\b" },
            { "pattern": "^podman\\s+inspect\\b" },
            { "pattern": "^podman\\s+logs\\b" },
            { "pattern": "^podman\\s+ps\\b" },
            { "pattern": "^prettier\\b" },
            { "pattern": "^pwd$" },
            { "pattern": "^rustc\\b" },
            { "pattern": "^rustfmt\\b" },
            { "pattern": "^rustup\\b" },
            { "pattern": "^sleep\\b" },
            { "pattern": "^tsc\\b" },
            { "pattern": "^tsx\\b" },
            { "pattern": "^which\\b" },
            { "pattern": "^yarn\\b" },
          ],
          "always_deny": [
            { "pattern": "^cargo\\s+install\\b" },
            { "pattern": "^cargo\\s+login\\b" },
            { "pattern": "^cargo\\s+owner\\b" },
            { "pattern": "^cargo\\s+publish\\b" },
            { "pattern": "^cargo\\s+yank\\b" },
            { "pattern": "chmod\\s+\\+s\\b" },
            { "pattern": "chmod\\s+u\\+s\\b" },
            { "pattern": "curl\\b.*\\|\\s*(bash|sh)\\b" },
            { "pattern": "^dd\\b" },
            { "pattern": "dotnet\\s+nuget\\s+add\\s+source\\b" },
            { "pattern": "dotnet\\s+nuget\\s+push\\b" },
            { "pattern": "dotnet\\s+tool\\s+install\\s+(--global|-g)\\b" },
            { "pattern": "gh\\s+auth\\b" },
            { "pattern": "gh\\s+secret\\b" },
            { "pattern": "git\\s+checkout\\s+\\.$" },
            { "pattern": "git\\s+config\\s+--global\\b" },
            { "pattern": "git\\s+push\\b.*--force\\b" },
            { "pattern": "git\\s+reset\\s+--hard\\b" },
            { "pattern": "go\\s+install\\b" },
            { "pattern": "^mkfs\\b" },
            { "pattern": "mvn\\s+deploy\\b" },
            { "pattern": "mvn\\s+release\\b" },
            { "pattern": "npm\\s+access\\b" },
            { "pattern": "^npm\\s+adduser$" },
            { "pattern": "npm\\s+config\\s+set\\b" },
            { "pattern": "^npm\\s+login$" },
            { "pattern": "npm\\s+owner\\b" },
            { "pattern": "npm\\s+publish\\b" },
            { "pattern": "npm\\s+token\\b" },
            { "pattern": "npm\\s+unpublish\\b" },
            { "pattern": "rm\\s+-rf\\b" },
            { "pattern": "rustup\\s+default\\b" },
            { "pattern": "rustup\\s+self\\b" },
            { "pattern": "^su\\b" },
            { "pattern": "^sudo\\b" },
            { "pattern": "wget\\b.*\\|\\s*sh\\b" },
            { "pattern": "yarn\\s+config\\s+set\\b" },
            { "pattern": "^yarn\\s+login$" },
            { "pattern": "^yarn\\s+npm\\s+login$" },
            { "pattern": "yarn\\s+npm\\s+publish\\b" },
            { "pattern": "yarn\\s+publish\\b" },
          ],
        },
      },
    },
  },
  "auto_install_extensions": {
    "catppuccin-icons": true,
    "csharp": false,
    "docker-compose": true,
    "dockerfile": true,
    "env": true,
    "git-firefly": true,
    "golangci-lint": true,
    "html": true,
    "java": false,
    "lua": true,
    "sql": true,
    "symbols": true,
    "terraform": false,
    "toml": true,
    "xml": true,
  },
  "auto_signature_help": true,
  "auto_update": false,
  "buffer_font_family": "Cascadia Code",
  "buffer_font_features": { "calt": true, "ss01": true },
  "buffer_font_size": 16,
  "collaboration_panel": {
    "button": false,
    "default_width": 256,
    "dock": "left",
  },
  "completions": { "words_min_length": 4 },
  "cli_default_open_behavior": "new_window",
  "current_line_highlight": "line",
  "cursor_blink": false,
  "diagnostics": { "inline": { "padding": 2 } },
  "edit_predictions": {
    "disabled_globs": [
      "//**/*.*env",
      "//**/*.cert",
      "//**/*.crt",
      "//**/*.env",
      "//**/*.key",
      "//**/*.ovpn",
      "//**/*.pem",
      "//**/*.secret",
      "//**/*credentials",
      "//**/*settings.xml",
      "//**/.secrets/**",
      "//**/keys/**",
      "//**/pass/**",
    ],
    "mode": "subtle",
  },
  "expand_excerpt_lines": 4,
  "file_finder": { "modal_max_width": "medium" },
  "file_scan_depth": 4,
  "format_on_save": "on",
  "git": {
    "inline_blame": { "enabled": true, "location": "status_bar", "padding": 2 },
  },
  "git_panel": { "default_width": 256, "dock": "left" },
  "gutter": { "min_line_number_digits": 3 },
  "horizontal_scroll_margin": 8,
  "icon_theme": {
    "dark": "Catppuccin Latte",
    "light": "Catppuccin Latte",
    "mode": "dark",
  },
  "indent_guides": { "enabled": false },
  "journal": { "hour_format": "hour24" },
  "language_models": {
    "openai_compatible": {
      "llama": {
        "api_url": "http://127.0.0.1:8080/v1",
        "available_models": [{ "max_tokens": 32768, "name": "llama" }],
      },
    },
  },
  "languages": {
    "Go": { "language_servers": ["gopls", "golangci-lint"] },
    "JavaScript": {
      "formatter": [
        {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"],
          },
        },
        { "code_action": "source.organizeImports" },
      ],
    },
    "Lua": {
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": ["--stdin-filepath", "{buffer_path}", "-"],
        },
      },
    },
    "Python": { "tab_size": 4 },
    "Rust": { "tab_size": 4 },
    "Shell Script": {
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}"],
        },
      },
    },
    // "Terraform": {
    //   "formatter": {
    //     "external": { "command": "terraform", "arguments": ["fmt", "-"] },
    //   },
    // },
    "TypeScript": {
      "formatter": [
        {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"],
          },
        },
        { "code_action": "source.organizeImports" },
      ],
    },
  },
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--issues-exit-code=1",
          "--output.json.path=stdout",
          "--show-stats=false",
        ],
      },
    },
    "gopls": {
      "initialization_options": {
        "analyses": { "shadow": true },
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true,
        },
      },
    },
    // "jdtls": {
    //   "initialization_options": {
    //     "settings": {
    //       "java": {
    //         "configuration": {
    //           "maven": { "userSettings": "~/.config/maven/settings.xml" },
    //         },
    //       },
    //     },
    //   },
    // },
    "rust-analyzer": {
      "initialization_options": {
        "check": { "command": "clippy" },
        "inlayHints": {
          "bindingModeHints": { "enable": true },
          "closureCaptureHints": { "enable": true },
          "closureReturnTypeHints": { "enable": "always" },
          "discriminantHints": { "enable": "always" },
          "expressionAdjustmentHints": { "enable": "always" },
          "implicitDrops": { "enable": true },
          "lifetimeElisionHints": { "enable": "always" },
          "rangeExclusiveHints": { "enable": true },
          "reborrowHints": { "enable": "always" },
        },
      },
    },
    // "terraform-ls": {
    //   "initialization_options": {
    //     "experimentalFeatures": { "prefillRequiredFields": true },
    //   },
    // },
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayEnumMemberValueHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true,
          "includeInlayFunctionParameterTypeHints": true,
          "includeInlayParameterNameHints": "all",
          "includeInlayParameterNameHintsWhenArgumentMatchesName": true,
          "includeInlayPropertyDeclarationTypeHints": true,
          "includeInlayVariableTypeHints": true,
          "includeInlayVariableTypeHintsWhenTypeMatchesName": true,
        },
      },
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "format": { "enabled": true, "singleQuote": true },
          "validate": false,
        },
      },
    },
  },
  "minimum_split_diff_width": 128,
  "mouse_wheel_zoom": true,
  "outline_panel": {
    "default_width": 256,
    "dock": "left",
    "expand_outlines_with_depth": 64,
    "indent_guides": { "show": "never" },
    "indent_size": 8,
  },
  "private_files": [
    "//**/*.*env",
    "//**/*.cert",
    "//**/*.crt",
    "//**/*.env",
    "//**/*.key",
    "//**/*.ovpn",
    "//**/*.pem",
    "//**/*.secret",
    "//**/*credentials",
    "//**/*settings.xml",
    "//**/.secrets/**",
    "//**/keys/**",
    "//**/pass/**",
  ],
  "project_panel": {
    "default_width": 256,
    "diagnostic_badges": true,
    "dock": "left",
    "git_status_indicator": true,
    "indent_guides": { "show": "never" },
    "indent_size": 8,
  },
  "restore_on_startup": "launchpad",
  "session": { "trust_all_worktrees": true },
  "show_whitespaces": "trailing",
  "status_bar": { "line_endings_button": true },
  "sticky_scroll": { "enabled": true },
  "tab_bar": { "show_nav_history_buttons": false },
  "tab_size": 2,
  "tabs": { "file_icons": true, "git_status": true, "show_diagnostics": "all" },
  "telemetry": { "diagnostics": false, "metrics": false },
  "terminal": {
    "copy_on_select": true,
    "cursor_shape": "bar",
    "default_height": 256,
    "default_width": 512,
    "font_size": 16,
    "line_height": "standard",
    "minimum_contrast": 0,
  },
  "theme": {
    "dark": "Gruvbox Material Flat Dark",
    "light": "Gruvbox Material Flat Light",
    "mode": "dark",
  },
  "title_bar": { "show_onboarding_banner": false },
  "toolbar": { "code_actions": true },
  "ui_font_size": 16,
  "use_smartcase_search": true,
  "vertical_scroll_margin": 4,
  "vim_mode": false,
  "which_key": { "enabled": true },
  "wrap_guides": [80],
}
